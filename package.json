{
  "name": "@hxp-tools/auditor-suite",
  "version": "1.3.2",
  "description": "Eight read-only audits for AI coding agents. One domain each. Scored reports agents can act on.",
  "bin": {
    "auditor-suite": "bin/install.js"
  },
  "scripts": {
    "start": "node bin/install.js",
    "pack:check": "npm pack --dry-run",
    "release:check": "bash scripts/lint.sh --verbose && bash tests/run.sh && bash tests/lint-selftest.sh && npm run pack:check",
    "prepublishOnly": "npm run release:check"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "audit",
    "security",
    "seo",
    "ux",
    "llm",
    "ai",
    "claude-code",
    "codex",
    "cursor",
    "agent-skills"
  ],
  "author": "hannsxpeter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hannsxpeter/auditor-suite.git"
  },
  "homepage": "https://github.com/hannsxpeter/auditor-suite#readme",
  "bugs": {
    "url": "https://github.com/hannsxpeter/auditor-suite/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin/",
    "skills/",
    "install.sh",
    "uninstall.sh",
    "VERSION",
    "SUITE.md",
    "README.md",
    "LICENSE"
  ]
}
